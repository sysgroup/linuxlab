"""Nagios check for a cached PLD Poldek update scan."""

import argparse
from pathlib import Path
import socket
import sys
import time


OK = 0
WARNING = 1
UNKNOWN = 3


def finish(code, message, count=None):
    label = {OK: "OK", WARNING: "WARNING", UNKNOWN: "UNKNOWN"}[code]
    perfdata = f" | updates={count};;;0" if count is not None else ""
    print(f"POLDEK {label} - {message}{perfdata}")
    return code


def parse_state(path):
    values = {}
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        if not raw_line or raw_line.startswith("#") or "=" not in raw_line:
            continue
        key, value = raw_line.split("=", 1)
        values[key.strip()] = value.strip()
    return values


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--state-file",
        type=Path,
        default=Path("/var/lib/nagios/poldek-monitoring/status"),
    )
    parser.add_argument(
        "--updates-file",
        type=Path,
        default=Path("/var/lib/nagios/poldek-monitoring/updates"),
    )
    parser.add_argument("--stale-hours", type=float, default=30.0)
    parser.add_argument("--hostname", default=socket.gethostname())
    parser.add_argument("--now", type=int, default=None, help=argparse.SUPPRESS)
    args = parser.parse_args()

    if args.stale_hours <= 0:
        return finish(UNKNOWN, "stale-hours must be positive")

    try:
        state = parse_state(args.state_file)
        timestamp = int(state["timestamp"])
        count = int(state["count"])
        refresh_status = state["status"]
    except FileNotFoundError:
        return finish(UNKNOWN, f"server {args.hostname}: no Poldek scan state")
    except (KeyError, OSError, UnicodeError, ValueError) as error:
        return finish(UNKNOWN, f"server {args.hostname}: invalid Poldek state ({error})")

    now = args.now if args.now is not None else int(time.time())
    age_seconds = max(0, now - timestamp)
    age_hours = age_seconds / 3600

    if refresh_status != "ok":
        reason = state.get("reason", "unknown_error").replace("_", " ")
        return finish(
            UNKNOWN,
            f"server {args.hostname}: last refresh failed ({reason}); age {age_hours:.1f}h",
        )

    if age_hours > args.stale_hours:
        return finish(
            UNKNOWN,
            f"server {args.hostname}: Poldek state is stale ({age_hours:.1f}h)",
            count,
        )

    if count < 0:
        return finish(UNKNOWN, f"server {args.hostname}: invalid negative update count")

    packages = []
    try:
        packages = [line.strip() for line in args.updates_file.read_text(encoding="utf-8").splitlines() if line.strip()]
    except FileNotFoundError:
        if count:
            return finish(UNKNOWN, f"server {args.hostname}: update list is missing")
    except (OSError, UnicodeError) as error:
        return finish(UNKNOWN, f"server {args.hostname}: cannot read update list ({error})")

    if count == 0:
        return finish(OK, f"server {args.hostname}: no pending package updates; state age {age_hours:.1f}h", 0)

    shown = ", ".join(packages[:10]) if packages else "package list unavailable"
    suffix = f", +{count - 10} more" if count > 10 else ""
    return finish(
        WARNING,
        f"server {args.hostname}: {count} pending package update(s): {shown}{suffix}; state age {age_hours:.1f}h",
        count,
    )


if __name__ == "__main__":
    sys.exit(main())
