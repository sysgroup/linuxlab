#cloud-config
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 SysGroup Sp. z o.o.
# ============================================================================
#  docker.yaml.tftpl  -  profil "docker" / Docker Engine + Compose
# ----------------------------------------------------------------------------
#  PL: Host kontenerowy. Tu wstaje docker-ce + plugin compose. Sam stack
#      (Uptime Kuma + MariaDB albo Prometheus/Grafana/Loki) wdrażasz potem przez
#      Ansible/compose - patrz komentarz na końcu. Terraform daje INFRASTRUKTURĘ,
#      a konfigurację aplikacji robi Ansible (czysty podział ról).
#  EN: A container host. We bring up docker-ce + the compose plugin. The actual
#      stack (Uptime Kuma + MariaDB, or Prometheus/Grafana/Loki) you deploy later
#      via Ansible/compose - see the note at the bottom. Terraform provides the
#      INFRASTRUCTURE; app config is Ansible's job (clean separation).
# ============================================================================

hostname: ${hostname}
fqdn: ${hostname}.${domain}

ssh_pwauth: true

users:
  - name: ${username}
    groups: [sudo, docker]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: false
    ssh_authorized_keys:
      - ${ssh_public_key}

chpasswd:
  expire: false
  users:
    - name: ${username}
      password: ${user_password}
      type: text

package_update: true
package_upgrade: false

packages:
  - qemu-guest-agent
  - ca-certificates
  - curl
  - gnupg

# PL: Instalacja Dockera z oficjalnego repo (działa na Debianie i Ubuntu -
#     wykrywamy ID dystrybucji w locie). Konto użytkownika jest już w grupie
#     "docker" (patrz users), więc docker bez sudo.
# EN: Install Docker from the official repo (works on Debian and Ubuntu - we
#     detect the distro ID at runtime). The user is already in the "docker"
#     group (see users), so docker works without sudo.
runcmd:
  - install -m 0755 -d /etc/apt/keyrings
  - . /etc/os-release; curl -fsSL https://download.docker.com/linux/$ID/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  - chmod a+r /etc/apt/keyrings/docker.gpg
  - . /etc/os-release; echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$ID $VERSION_CODENAME stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - systemctl enable --now docker
  # PL: Tutaj (lub przez Ansible) wrzuć compose dla Uptime Kuma + MariaDB, np.:
  #     docker compose -f /opt/uptime-kuma/docker-compose.yml up -d
  # EN: Drop in a compose file (or do it via Ansible) for Uptime Kuma + MariaDB.

final_message: "cloud-init OK - Docker gotowy na ${hostname}.${domain} / Docker ready."
